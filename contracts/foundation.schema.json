{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenyou.site/contracts/foundation-v1.schema.json",
  "title": "Wenyou Foundation Contract",
  "type": "object",
  "required": ["schemaVersion", "version", "identity", "palette", "typography", "motion", "profiles", "experiences", "fonts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "identity": { "type": "object" },
    "palette": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#[0-9A-F]{6}$" } },
    "typography": { "type": "object" },
    "motion": { "type": "object" },
    "profiles": { "type": "object", "required": ["web", "mobile"] },
    "experiences": { "type": "object", "required": ["collections", "editor", "images"] },
    "fonts": { "type": "array", "minItems": 3 }
  },
  "additionalProperties": false
}
