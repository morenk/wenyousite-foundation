{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wenyou.site/contracts/foundation-v1.schema.json",
  "title": "Wenyou Foundation Contract",
  "type": "object",
  "required": ["$schema", "schemaVersion", "version", "identity", "palette", "typography", "motion", "accessibility", "profiles", "experiences", "fonts"],
  "properties": {
    "$schema": { "const": "./foundation.schema.json" },
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "identity": {
      "type": "object",
      "required": ["subject", "keywords", "canvas", "signature"],
      "properties": {
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "keywords": { "$ref": "#/$defs/nonEmptyStringArray" },
        "canvas": { "const": "pure-white" },
        "signature": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "required": ["background", "foreground", "surface", "primary", "onPrimary", "brandStrong", "secondary", "onSecondary", "muted", "mutedForeground", "accent", "onAccent", "like", "bookmark", "border", "input", "destructive", "onDestructive", "destructiveSoft", "success", "successSoft", "warning", "warningSoft", "info", "infoSoft", "categoryDeduction", "categoryDeductionSoft", "categoryNation", "categoryNationSoft", "categoryRpg", "categoryRpgSoft"],
      "properties": {
        "background": { "$ref": "#/$defs/hexColor" },
        "foreground": { "$ref": "#/$defs/hexColor" },
        "surface": { "$ref": "#/$defs/hexColor" },
        "primary": { "$ref": "#/$defs/hexColor" },
        "onPrimary": { "$ref": "#/$defs/hexColor" },
        "brandStrong": { "$ref": "#/$defs/hexColor" },
        "secondary": { "$ref": "#/$defs/hexColor" },
        "onSecondary": { "$ref": "#/$defs/hexColor" },
        "muted": { "$ref": "#/$defs/hexColor" },
        "mutedForeground": { "$ref": "#/$defs/hexColor" },
        "accent": { "$ref": "#/$defs/hexColor" },
        "onAccent": { "$ref": "#/$defs/hexColor" },
        "like": { "$ref": "#/$defs/hexColor" },
        "bookmark": { "$ref": "#/$defs/hexColor" },
        "border": { "$ref": "#/$defs/hexColor" },
        "input": { "$ref": "#/$defs/hexColor" },
        "destructive": { "$ref": "#/$defs/hexColor" },
        "onDestructive": { "$ref": "#/$defs/hexColor" },
        "destructiveSoft": { "$ref": "#/$defs/hexColor" },
        "success": { "$ref": "#/$defs/hexColor" },
        "successSoft": { "$ref": "#/$defs/hexColor" },
        "warning": { "$ref": "#/$defs/hexColor" },
        "warningSoft": { "$ref": "#/$defs/hexColor" },
        "info": { "$ref": "#/$defs/hexColor" },
        "infoSoft": { "$ref": "#/$defs/hexColor" },
        "categoryDeduction": { "$ref": "#/$defs/hexColor" },
        "categoryDeductionSoft": { "$ref": "#/$defs/hexColor" },
        "categoryNation": { "$ref": "#/$defs/hexColor" },
        "categoryNationSoft": { "$ref": "#/$defs/hexColor" },
        "categoryRpg": { "$ref": "#/$defs/hexColor" },
        "categoryRpgSoft": { "$ref": "#/$defs/hexColor" }
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["body", "display", "utility"],
      "properties": {
        "body": { "$ref": "#/$defs/fontFamily" },
        "display": { "$ref": "#/$defs/fontFamily" },
        "utility": { "$ref": "#/$defs/fontFamily" }
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "required": ["fastMs", "standardMs", "slowMs", "standardEase", "exitEase"],
      "properties": {
        "fastMs": { "$ref": "#/$defs/positiveNumber" },
        "standardMs": { "$ref": "#/$defs/positiveNumber" },
        "slowMs": { "$ref": "#/$defs/positiveNumber" },
        "standardEase": { "$ref": "#/$defs/nonEmptyString" },
        "exitEase": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "accessibility": { "$ref": "#/$defs/accessibility" },
    "profiles": {
      "type": "object",
      "required": ["web", "mobile"],
      "properties": {
        "web": { "$ref": "#/$defs/webProfile" },
        "mobile": { "$ref": "#/$defs/mobileProfile" }
      },
      "additionalProperties": false
    },
    "experiences": {
      "type": "object",
      "required": ["icons", "collections", "elements", "feedback", "overlays", "navigation", "language", "notifications", "editor", "images"],
      "properties": {
        "icons": { "$ref": "#/$defs/icons" },
        "collections": { "$ref": "#/$defs/collections" },
        "elements": { "$ref": "#/$defs/elements" },
        "feedback": { "$ref": "#/$defs/feedback" },
        "overlays": { "$ref": "#/$defs/overlays" },
        "navigation": { "$ref": "#/$defs/navigation" },
        "language": { "$ref": "#/$defs/language" },
        "notifications": { "$ref": "#/$defs/notifications" },
        "editor": { "$ref": "#/$defs/editor" },
        "images": { "$ref": "#/$defs/images" }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/fontAsset" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "hexColor": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "fontFamily": {
      "type": "object",
      "required": ["family", "weights", "fallback"],
      "properties": {
        "family": { "$ref": "#/$defs/nonEmptyString" },
        "weights": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 } },
        "fallback": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": false
    },
    "typeStyle": {
      "type": "object",
      "required": ["family", "size", "lineHeight", "weight"],
      "properties": {
        "family": { "enum": ["body", "display", "utility"] },
        "size": { "$ref": "#/$defs/positiveNumber" },
        "lineHeight": { "$ref": "#/$defs/positiveNumber" },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900, "multipleOf": 100 }
      },
      "additionalProperties": false
    },
    "typeScale": {
      "type": "object",
      "required": ["pageTitle", "sectionTitle", "subsectionTitle", "body", "compactBody", "label", "caption", "reading"],
      "properties": {
        "pageTitle": { "$ref": "#/$defs/typeStyle" },
        "sectionTitle": { "$ref": "#/$defs/typeStyle" },
        "subsectionTitle": { "$ref": "#/$defs/typeStyle" },
        "body": { "$ref": "#/$defs/typeStyle" },
        "compactBody": { "$ref": "#/$defs/typeStyle" },
        "label": { "$ref": "#/$defs/typeStyle" },
        "caption": { "$ref": "#/$defs/typeStyle" },
        "reading": { "$ref": "#/$defs/typeStyle" }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": ["contrast", "invariants", "web", "mobile"],
      "properties": {
        "contrast": {
          "type": "object",
          "required": ["normalText", "largeText", "nonText"],
          "properties": {
            "normalText": { "type": "number", "minimum": 4.5 },
            "largeText": { "type": "number", "minimum": 3 },
            "nonText": { "type": "number", "minimum": 3 }
          },
          "additionalProperties": false
        },
        "invariants": {
          "type": "object",
          "required": ["focusVisible", "statusNeverColorOnly", "iconOnlyControlHasLabel", "reducedMotion", "asyncAnnouncement"],
          "properties": {
            "focusVisible": { "const": true },
            "statusNeverColorOnly": { "const": true },
            "iconOnlyControlHasLabel": { "const": true },
            "reducedMotion": { "const": "respect-user" },
            "asyncAnnouncement": { "const": "polite-unless-critical" }
          },
          "additionalProperties": false
        },
        "web": {
          "type": "object",
          "required": ["keyboardOperable", "browserZoom"],
          "properties": { "keyboardOperable": { "const": true }, "browserZoom": { "const": "preserve-function" } },
          "additionalProperties": false
        },
        "mobile": {
          "type": "object",
          "required": ["systemTextScale", "safeArea", "systemBack"],
          "properties": { "systemTextScale": { "const": true }, "safeArea": { "const": true }, "systemBack": { "const": true } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "radii": {
      "type": "object",
      "required": ["compact", "control", "panel"],
      "properties": {
        "compact": { "$ref": "#/$defs/positiveNumber" },
        "control": { "$ref": "#/$defs/positiveNumber" },
        "panel": { "$ref": "#/$defs/positiveNumber" },
        "pill": { "$ref": "#/$defs/positiveNumber" }
      },
      "additionalProperties": false
    },
    "webProfile": {
      "type": "object",
      "required": ["unit", "minimumViewport", "expandedChromeFrom", "minimumControlTarget", "minimumCompactTarget", "radii", "layoutRem", "reading", "typeScale"],
      "properties": {
        "unit": { "const": "px" },
        "minimumViewport": { "$ref": "#/$defs/positiveNumber" },
        "expandedChromeFrom": { "$ref": "#/$defs/positiveNumber" },
        "minimumControlTarget": { "$ref": "#/$defs/positiveNumber" },
        "minimumCompactTarget": { "$ref": "#/$defs/positiveNumber" },
        "radii": { "$ref": "#/$defs/radii" },
        "layoutRem": {
          "type": "object",
          "required": ["narrow", "moment", "feed", "content", "workspace", "chromeWorkspace", "wide"],
          "properties": {
            "narrow": { "$ref": "#/$defs/positiveNumber" }, "moment": { "$ref": "#/$defs/positiveNumber" }, "feed": { "$ref": "#/$defs/positiveNumber" }, "content": { "$ref": "#/$defs/positiveNumber" }, "workspace": { "$ref": "#/$defs/positiveNumber" }, "chromeWorkspace": { "$ref": "#/$defs/positiveNumber" }, "wide": { "$ref": "#/$defs/positiveNumber" }
          },
          "additionalProperties": false
        },
        "reading": {
          "type": "object",
          "required": ["bodyPx", "lineHeightPx", "maxFullWidthCharacters"],
          "properties": { "bodyPx": { "$ref": "#/$defs/positiveNumber" }, "lineHeightPx": { "$ref": "#/$defs/positiveNumber" }, "maxFullWidthCharacters": { "$ref": "#/$defs/positiveNumber" } },
          "additionalProperties": false
        },
        "typeScale": { "$ref": "#/$defs/typeScale" }
      },
      "additionalProperties": false
    },
    "mobileProfile": {
      "type": "object",
      "required": ["unit", "minimumViewport", "minimumControlTarget", "spacing", "radii", "horizontalPadding", "pageContentMaxWidth", "wideContainerMaxWidth", "reading", "typeScale"],
      "properties": {
        "unit": { "const": "dp" },
        "minimumViewport": { "$ref": "#/$defs/positiveNumber" },
        "minimumControlTarget": { "$ref": "#/$defs/positiveNumber" },
        "spacing": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/positiveNumber" } },
        "radii": { "$ref": "#/$defs/radii" },
        "horizontalPadding": {
          "type": "object",
          "required": ["compact", "regular", "regularFrom"],
          "properties": { "compact": { "$ref": "#/$defs/positiveNumber" }, "regular": { "$ref": "#/$defs/positiveNumber" }, "regularFrom": { "$ref": "#/$defs/positiveNumber" } },
          "additionalProperties": false
        },
        "pageContentMaxWidth": { "$ref": "#/$defs/positiveNumber" },
        "wideContainerMaxWidth": { "$ref": "#/$defs/positiveNumber" },
        "reading": {
          "type": "object",
          "required": ["bodySp", "lineHeight"],
          "properties": { "bodySp": { "$ref": "#/$defs/positiveNumber" }, "lineHeight": { "$ref": "#/$defs/positiveNumber" } },
          "additionalProperties": false
        },
        "typeScale": { "$ref": "#/$defs/typeScale" }
      },
      "additionalProperties": false
    },
    "icons": {
      "type": "object",
      "required": ["source", "style", "controls", "semantics", "platformExceptions"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["family", "package", "version", "integrity", "license", "viewBox"],
          "properties": {
            "family": { "$ref": "#/$defs/nonEmptyString" }, "package": { "$ref": "#/$defs/nonEmptyString" }, "version": { "$ref": "#/$defs/nonEmptyString" }, "integrity": { "$ref": "#/$defs/nonEmptyString" }, "license": { "$ref": "#/$defs/nonEmptyString" }, "viewBox": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        "style": {
          "type": "object",
          "required": ["strokeWidth", "lineCap", "lineJoin", "compactSize", "defaultSize", "navigationSize", "selectedState", "decorativeSemantics", "interactiveLabelOwner"],
          "properties": {
            "strokeWidth": { "$ref": "#/$defs/positiveNumber" }, "lineCap": { "const": "round" }, "lineJoin": { "const": "round" }, "compactSize": { "$ref": "#/$defs/positiveNumber" }, "defaultSize": { "$ref": "#/$defs/positiveNumber" }, "navigationSize": { "$ref": "#/$defs/positiveNumber" }, "selectedState": { "const": "semantic-color-on-transparent-container" }, "decorativeSemantics": { "const": "hidden" }, "interactiveLabelOwner": { "const": "control" }
          },
          "additionalProperties": false
        },
        "controls": {
          "type": "object",
          "required": ["inactive", "selected", "commands", "supportingContent", "focusRing", "stateLayer", "disabledContentOpacity", "hostSurfaces", "coloredSurfaceBehavior", "pendingVisual"],
          "properties": {
            "inactive": {
              "type": "object",
              "required": ["foreground", "surface", "glyph"],
              "properties": {
                "foreground": { "const": "mutedForeground" },
                "surface": { "const": "transparent" },
                "glyph": { "const": "outline" }
              },
              "additionalProperties": false
            },
            "selected": {
              "type": "object",
              "required": ["default", "like", "bookmark", "subscription"],
              "properties": {
                "default": {
                  "type": "object",
                  "required": ["foreground", "surface", "glyph", "requiresVisibleStateCue"],
                  "properties": {
                    "foreground": { "const": "onAccent" },
                    "surface": { "const": "transparent" },
                    "glyph": { "const": "unchanged" },
                    "requiresVisibleStateCue": { "const": true }
                  },
                  "additionalProperties": false
                },
                "like": {
                  "type": "object",
                  "required": ["semanticId", "foreground", "surface", "glyph"],
                  "properties": {
                    "semanticId": { "const": "action.like" },
                    "foreground": { "const": "like" },
                    "surface": { "const": "transparent" },
                    "glyph": { "const": "filled" }
                  },
                  "additionalProperties": false
                },
                "bookmark": {
                  "type": "object",
                  "required": ["semanticId", "foreground", "surface", "glyph"],
                  "properties": {
                    "semanticId": { "const": "action.bookmark" },
                    "foreground": { "const": "bookmark" },
                    "surface": { "const": "transparent" },
                    "glyph": { "const": "filled" }
                  },
                  "additionalProperties": false
                },
                "subscription": {
                  "type": "object",
                  "required": ["semanticId", "foreground", "surface", "glyph"],
                  "properties": {
                    "semanticId": { "const": "action.subscribe" },
                    "foreground": { "const": "brandStrong" },
                    "surface": { "const": "transparent" },
                    "glyph": { "const": "filled" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "commands": {
              "type": "object",
              "required": ["neutral", "destructive"],
              "properties": {
                "neutral": {
                  "type": "object",
                  "required": ["foreground", "hoverSurface"],
                  "properties": {
                    "foreground": { "const": "foreground" },
                    "hoverSurface": { "const": "muted" }
                  },
                  "additionalProperties": false
                },
                "destructive": {
                  "type": "object",
                  "required": ["foreground", "hoverSurface"],
                  "properties": {
                    "foreground": { "const": "destructive" },
                    "hoverSurface": { "const": "destructiveSoft" }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "supportingContent": {
              "type": "object",
              "required": ["inactive", "selected"],
              "properties": {
                "inactive": { "const": "mutedForeground" },
                "selected": { "const": "foreground" }
              },
              "additionalProperties": false
            },
            "focusRing": { "const": "brandStrong" },
            "stateLayer": {
              "type": "object",
              "required": ["color", "shape", "target", "hoverOpacity", "focusOpacity", "pressedOpacity"],
              "properties": {
                "color": { "const": "currentColor" },
                "shape": { "const": "circle" },
                "target": { "const": "icon-hit-area" },
                "hoverOpacity": { "const": 0.1 },
                "focusOpacity": { "const": 0.1 },
                "pressedOpacity": { "const": 0.15 }
              },
              "additionalProperties": false
            },
            "disabledContentOpacity": { "const": 0.38 },
            "hostSurfaces": { "type": "array", "prefixItems": [{ "const": "background" }, { "const": "surface" }, { "const": "muted" }], "items": false, "minItems": 3, "maxItems": 3 },
            "coloredSurfaceBehavior": { "const": "use-on-color-neutral" },
            "pendingVisual": { "const": "preserve-state-with-loading-indicator" }
          },
          "additionalProperties": false
        },
        "semantics": { "type": "object", "minProperties": 1, "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" }, "additionalProperties": { "$ref": "#/$defs/nonEmptyString" } },
        "platformExceptions": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "additionalProperties": false
    },
    "collections": {
      "type": "object",
      "required": ["invariants", "web", "mobile"],
      "properties": {
        "invariants": {
          "type": "object",
          "required": ["containerWidth", "itemWidth", "narrowContentDoesNotChangeItemWidth", "horizontalOverflow", "contentSizedExceptions"],
          "properties": { "containerWidth": { "const": "available" }, "itemWidth": { "const": "available" }, "narrowContentDoesNotChangeItemWidth": { "const": true }, "horizontalOverflow": { "const": "explicit-only" }, "contentSizedExceptions": { "$ref": "#/$defs/nonEmptyStringArray" } },
          "additionalProperties": false
        },
        "web": { "type": "object", "required": ["tabPanelWidth", "multiColumn"], "properties": { "tabPanelWidth": { "const": "available" }, "multiColumn": { "const": "explicit-grid-only" } }, "additionalProperties": false },
        "mobile": { "type": "object", "required": ["layout", "itemWidth"], "properties": { "layout": { "const": "single-column" }, "itemWidth": { "const": "available" } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "elementTone": { "enum": ["neutral", "brand", "success", "warning", "danger", "info"] },
    "paletteToken": {
      "enum": ["transparent", "foreground", "mutedForeground", "brandStrong", "primary", "accent", "onAccent", "muted", "border", "destructive", "onDestructive", "destructiveSoft", "success", "successSoft", "warning", "warningSoft", "info", "infoSoft"]
    },
    "elementColorPair": {
      "type": "object",
      "required": ["foreground", "surface"],
      "properties": { "foreground": { "$ref": "#/$defs/paletteToken" }, "surface": { "$ref": "#/$defs/paletteToken" } },
      "additionalProperties": false
    },
    "elements": {
      "type": "object",
      "required": ["ownership", "invariants", "inline", "block", "metadata", "web", "mobile"],
      "properties": {
        "ownership": {
          "type": "object",
          "required": ["inline", "block", "metadata", "controls", "surfaces"],
          "properties": {
            "inline": { "const": "elements.inline" },
            "block": { "const": "elements.block" },
            "metadata": { "const": "elements.metadata" },
            "controls": { "const": "icons.controls" },
            "surfaces": { "const": "profiles" }
          },
          "additionalProperties": false
        },
        "invariants": {
          "type": "object",
          "required": ["statusNeverColorOnly", "readingEditorEquivalent", "editorInternalReferenceNavigation", "nonInteractiveBadgeTarget", "interactiveTargetUsesPlatformMinimum", "protocolOwner", "categoryColorNeedsTextLabel"],
          "properties": {
            "statusNeverColorOnly": { "const": true },
            "readingEditorEquivalent": { "const": true },
            "editorInternalReferenceNavigation": { "const": "prevented" },
            "nonInteractiveBadgeTarget": { "const": "content-sized" },
            "interactiveTargetUsesPlatformMinimum": { "const": true },
            "protocolOwner": { "const": "backend-contracts" },
            "categoryColorNeedsTextLabel": { "const": true }
          },
          "additionalProperties": false
        },
        "inline": {
          "type": "object",
          "required": ["internalReference", "link", "mention", "code", "dice"],
          "properties": {
            "internalReference": {
              "type": "object",
              "required": ["tone", "foreground", "surface", "border", "weight", "icon", "overflow", "editorBehavior"],
              "properties": {
                "tone": { "const": "brand" }, "foreground": { "const": "onAccent" }, "surface": { "const": "accent" }, "border": { "const": "transparent" }, "weight": { "const": 600 }, "icon": { "const": "content.internal-reference" }, "overflow": { "const": "wrap-no-truncate" }, "editorBehavior": { "const": "atomic-no-navigation" }
              },
              "additionalProperties": false
            },
            "link": {
              "type": "object",
              "required": ["tone", "foreground", "weight", "underlineWidthPx", "underlineOffsetEm", "externalBehavior"],
              "properties": {
                "tone": { "const": "brand" }, "foreground": { "const": "brandStrong" }, "weight": { "const": 600 }, "underlineWidthPx": { "const": 1 }, "underlineOffsetEm": { "const": 0.18 }, "externalBehavior": { "const": "new-tab" }
              },
              "additionalProperties": false
            },
            "mention": {
              "type": "object",
              "required": ["tone", "foreground", "surface", "weight", "prefix", "editorBehavior"],
              "properties": {
                "tone": { "const": "brand" }, "foreground": { "const": "brandStrong" }, "surface": { "const": "transparent" }, "weight": { "const": 600 }, "prefix": { "const": "@" }, "editorBehavior": { "const": "atomic" }
              },
              "additionalProperties": false
            },
            "code": {
              "type": "object",
              "required": ["tone", "foreground", "surface", "family", "sizeEm", "radiusEm", "paddingBlockEm", "paddingInlineEm"],
              "properties": {
                "tone": { "const": "neutral" }, "foreground": { "const": "foreground" }, "surface": { "const": "muted" }, "family": { "const": "platform-monospace" }, "sizeEm": { "const": 0.88 }, "radiusEm": { "const": 0.35 }, "paddingBlockEm": { "const": 0.12 }, "paddingInlineEm": { "const": 0.35 }
              },
              "additionalProperties": false
            },
            "dice": {
              "type": "object",
              "required": ["tone", "family", "numbers", "radiusEm", "paddingBlockEm", "paddingInlineEm", "settled", "pending"],
              "properties": {
                "tone": { "const": "brand" }, "family": { "const": "utility" }, "numbers": { "const": "tabular" }, "radiusEm": { "const": 0.3 }, "paddingBlockEm": { "const": 0.08 }, "paddingInlineEm": { "const": 0.3 },
                "settled": { "$ref": "#/$defs/elementColorPair" },
                "pending": { "type": "object", "required": ["foreground", "surface", "display"], "properties": { "foreground": { "const": "warning" }, "surface": { "const": "warningSoft" }, "display": { "const": "?" } }, "additionalProperties": false }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "block": {
          "type": "object",
          "required": ["quote", "divider"],
          "properties": {
            "quote": {
              "type": "object",
              "required": ["foreground", "surface", "marker", "markerWidthPx", "radius", "fontStyle", "paddingBlockEm", "paddingInlineEm"],
