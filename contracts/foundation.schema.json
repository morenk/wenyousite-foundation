            "level": { "type": "object", "required": ["tone", "format", "foreground", "surface", "heightPx", "fontSizePx", "weight", "family", "numbers", "radius"], "properties": { "tone": { "const": "brand" }, "format": { "const": "Lv.N" }, "foreground": { "const": "onAccent" }, "surface": { "const": "accent" }, "heightPx": { "const": 20 }, "fontSizePx": { "const": 11 }, "weight": { "const": 700 }, "family": { "const": "utility" }, "numbers": { "const": "tabular" }, "radius": { "const": "compact" } }, "additionalProperties": false },
            "unreadCount": { "type": "object", "required": ["tone", "foreground", "surface", "heightPx", "fontSizePx", "weight", "family", "numbers", "maximumDisplay", "zeroBehavior"], "properties": { "tone": { "const": "danger" }, "foreground": { "const": "onDestructive" }, "surface": { "const": "destructive" }, "heightPx": { "const": 16 }, "fontSizePx": { "const": 10 }, "weight": { "const": 700 }, "family": { "const": "utility" }, "numbers": { "const": "tabular" }, "maximumDisplay": { "const": "99+" }, "zeroBehavior": { "const": "hidden" } }, "additionalProperties": false },
