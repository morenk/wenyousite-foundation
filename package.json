{
  "name": "@wenyousite/foundation",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": "./contracts/foundation.v1.json",
    "./manifest": "./foundation-manifest.json",
    "./editor": {
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./collections": {
      "types": "./dist/collections.d.ts",
      "default": "./dist/collections.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "default": "./dist/notifications.js"
    },
    "./typography": {
      "types": "./dist/typography.d.ts",
      "default": "./dist/typography.js"
    },
    "./interaction": {
      "types": "./dist/interaction.d.ts",
      "default": "./dist/interaction.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./language": {
      "types": "./dist/language.d.ts",
      "default": "./dist/language.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./web/tokens.css": "./web/tokens.css",
    "./web/fonts.css": "./web/fonts.css"
  },
  "files": [
    "contracts",
    "dist",
    "docs",
    "foundation-manifest.json",
    "licenses",
    "skills",
    "web"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/check.mjs && node scripts/generate.mjs --check && python3 scripts/check-fonts.py"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "lucide-static": "1.28.0"
  },
  "devDependencies": {
    "ajv": "8.17.1"
  },
  "packageManager": "pnpm@11.17.0"
}
